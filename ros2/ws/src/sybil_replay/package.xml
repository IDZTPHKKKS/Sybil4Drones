  <version>0.1.0</version>
  <description>Replays simulator missions through the trust nodes as rosbag2 recordings, checks and visualises them</description>
  <maintainer email="114971215+IDZTPHKKKS@users.noreply.github.com">Shyaam Mahesh</maintainer>
  <license>MIT</license>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>rosbag2_py</exec_depend>
  <exec_depend>rosbag2_interfaces</exec_depend>
  <exec_depend>ros2bag</exec_depend>
